<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the L draws itself and the dot drops onto it, then the in-app intro takes over. -->
    <style name="Theme.Lian" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_lian_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_solid</item>
        <item name="android:windowSplashScreenAnimationDuration">950</item>
    </style>
</resources>