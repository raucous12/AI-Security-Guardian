<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device-to-device transfer (Phase 2, channel 5).
     allowBackup="false" alone doesn't stop device-to-device transfer on some Android 12+ devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
